# Optional. If empty, moments are ranked by transcript + voice energy only.
# OpenAI-compatible: OpenAI, Groq, Together, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Whisper: large-v3 точнее и медленнее; large-v3-turbo быстрее
WHISPER_MODEL=large-v3

# Водяной знак на роликах, например twitch.tv/ник
WATERMARK=

DATA_DIR=data
HOST=127.0.0.1
PORT=8741
